{
    "name": "owenbush/upkeep",
    "description": "Maintenance orchestrator CLI for contributed Drupal modules: cockpit-driven module registry, fixtures, and merge-request workflows.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "drupal",
        "maintenance",
        "cli",
        "contrib"
    ],
    "authors": [
        {
            "name": "Owen Bush",
            "email": "owen@obush.co.uk"
        }
    ],
    "require": {
        "php": ">=8.2",
        "composer/semver": "^3.4",
        "symfony/console": "^7.2 || ^8.0",
        "symfony/http-client": "^7.2 || ^8.0",
        "symfony/process": "^7.2 || ^8.0",
        "symfony/yaml": "^7.2 || ^8.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^11.5",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "bin": [
        "bin/upkeep"
    ],
    "autoload": {
        "psr-4": {
            "Upkeep\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Upkeep\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        }
    },
    "scripts": {
        "lint": "phpcs",
        "lint:fix": "phpcbf",
        "analyse": "phpstan analyse --no-progress",
        "docs:commands": "@php tools/generate-command-reference.php",
        "docs:check": "@php tools/generate-command-reference.php --check"
    },
    "minimum-stability": "stable"
}
