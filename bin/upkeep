#!/usr/bin/env php
<?php

declare(strict_types=1);

use Composer\InstalledVersions;
use Symfony\Component\Console\Application;
use Upkeep\Adapter\DdevContribAdapterFactory;
use Upkeep\Adapter\ProcessRunner;
use Upkeep\Adapter\VolumeProbe;
use Upkeep\Command\ApiProbeCommand;
use Upkeep\Command\BaseArtifactsBuildCommand;
use Upkeep\Command\BaseArtifactsStatusCommand;
use Upkeep\Command\CheckCommand;
use Upkeep\Command\DashboardCommand;
use Upkeep\Command\DevCommand;
use Upkeep\Command\EnvPathCommand;
use Upkeep\Command\ExecCommand;
use Upkeep\Command\ExplainCommand;
use Upkeep\Command\InitCommand;
use Upkeep\Command\IssuesCommand;
use Upkeep\Command\IssueCommand;
use Upkeep\Command\MergeCommand;
use Upkeep\Command\ModulesAddCommand;
use Upkeep\Command\ModulesCommand;
use Upkeep\Command\NeedsWorkCommand;
use Upkeep\Command\NotesCommand;
use Upkeep\Command\PatchApplyCommand;
use Upkeep\Command\PatchCheckCommand;
use Upkeep\Command\PatchPromoteCommand;
use Upkeep\Command\PatchesCommand;
use Upkeep\Command\PruneCommand;
use Upkeep\Command\PublishCommand;
use Upkeep\Command\ReviewCommand;
use Upkeep\Command\StartCommand;
use Upkeep\Command\StatusCommand;
use Upkeep\Command\UiCommand;
use Upkeep\Command\VersionOptionInput;
use Upkeep\Security\SecretRedactor;
use Upkeep\Workflow\ExitCode;
use Upkeep\Workflow\RuntimeRequirements;

foreach ([__DIR__ . '/../../../autoload.php', __DIR__ . '/../vendor/autoload.php'] as $autoload) {
    if (file_exists($autoload)) {
        require $autoload;
        break;
    }
}

// Before anything is constructed: is what composer.json declares actually
// installed? A checkout that pulled a commit adding a dependency has a
// vendor/ older than its code, and every path that reaches the new package
// dies with an uncaught "Class ... not found" partway through a command. This
// is the exit-code contract applied to the one failure that used to escape it
// — 2, because upkeep could not do the job, with the command that fixes it.
$missingPackages = RuntimeRequirements::missing(
    RuntimeRequirements::declaredIn(__DIR__ . '/../composer.json'),
    InstalledVersions::isInstalled(...),
);
if ($missingPackages !== []) {
    fwrite(STDERR, RuntimeRequirements::message($missingPackages, \dirname(__DIR__)));

    exit(ExitCode::INFRASTRUCTURE);
}

// ---------------------------------------------------------------------------
// Composition root.
//
// This file is the ONLY place outside src/Adapter/ that names a concrete
// engine. Commands receive an EngineAdapterFactory and never choose, name, or
// construct an engine themselves — which is what makes the adapter-boundary
// guard (`grep -ri "ddev" src/ --exclude-dir=Adapter`) meaningful rather than
// merely satisfied by the capital D in a class name.
// ---------------------------------------------------------------------------
$redactor = SecretRedactor::fromEnvironment();
$engines = new DdevContribAdapterFactory($redactor);
$volumeProbe = VolumeProbe::withRunner(new ProcessRunner(static function (string $line): void {
}, $redactor));

$application = new Application('Upkeep', 'dev');
$application->addCommands([
    new ApiProbeCommand(),
    new BaseArtifactsBuildCommand(),
    new BaseArtifactsStatusCommand(),
    new CheckCommand($engines),
    new DashboardCommand(),
    new DevCommand($engines),
    new EnvPathCommand($engines),
    new ExecCommand($engines),
    new ExplainCommand(),
    new InitCommand(),
    new IssueCommand(),
    new IssuesCommand(),
    new MergeCommand(),
    new NeedsWorkCommand(),
    new ModulesAddCommand(),
    new ModulesCommand(),
    new NotesCommand(),
    new PatchApplyCommand($engines),
    new PatchCheckCommand($engines),
    new PatchPromoteCommand($engines),
    new PatchesCommand(),
    new PruneCommand($engines, $volumeProbe),
    new PublishCommand($engines),
    new ReviewCommand($engines),
    new StartCommand($engines),
    new StatusCommand($volumeProbe),
    new UiCommand(),
]);

// The check/review/dashboard commands use --version as the target-core
// selector, so the application-level --version option is dropped and the
// doRun() hijack neutralized (see VersionOptionInput). `upkeep list` still
// shows the app version in its header.
$definition = $application->getDefinition();
$definition->setOptions(array_filter(
    $definition->getOptions(),
    static fn ($option): bool => $option->getName() !== 'version',
));
$application->run(new VersionOptionInput());
